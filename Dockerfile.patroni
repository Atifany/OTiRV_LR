FROM postgres:16

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip \
 && pip3 install --break-system-packages "patroni[etcd3,psycopg2-binary]==4.1.5" \
 && rm -rf /var/lib/apt/lists/*

COPY patroni/entrypoint.sh /usr/local/bin/entrypoint-patroni.sh
RUN chmod +x /usr/local/bin/entrypoint-patroni.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-patroni.sh"]
CMD ["/patroni.yml"]